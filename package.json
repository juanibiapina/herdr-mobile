{
  "name": "herdr-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "postinstall": "node scripts/build-terminal-html.mjs && node scripts/build-mod-files.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publish:update": "eas update --channel preview --platform android --environment preview --non-interactive",
    "pretest": "node scripts/build-mod-files.mjs",
    "pretypecheck": "node scripts/build-mod-files.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@xterm/addon-fit": "0.12.0-beta.332",
    "@xterm/addon-image": "0.10.0-beta.331",
    "@xterm/xterm": "6.1.0-beta.336",
    "expo": "~57.0.27",
    "expo-build-properties": "^57.0.22",
    "expo-clipboard": "^57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-modules-core": "~57.0.24",
    "expo-notifications": "^57.0.24",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@jitl/quickjs-ng-wasmfile-release-sync": "0.32.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.18",
    "eas-cli": "^27.2.0",
    "esbuild": "^0.28.2",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "patchedDependencies": {
      "@xterm/addon-image@0.10.0-beta.331": "patches/@xterm__addon-image@0.10.0-beta.331.patch"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  }
}
